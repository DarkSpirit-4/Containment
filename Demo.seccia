{
"sid": 87,
"uid": "D_GUARD",
"content": {
"sentence": {
"sentences": [
{
"id": 4,
"sentences": [
{
"id": 5,
"text": {
"en": "Aujourd'hui, tu es chargé de préparer les repas, au boulot."
},
"voice": {
"en": [
{},
{},
{},
{}
]
},
"speaker": "O_GUARD"
}
],
"text": {
"en": "Boujour."
},
"voice": {
"en": [
{},
{},
{},
{}
]
},
"speaker": "O_NEW"
},
{
"id": 6,
"sentences": [
{
"id": 7,
"sentences": [
{
"id": 8,
"text": {
"en": "Pousse-toi, je dois passer."
},
"voice": {
"en": [
{},
{},
{},
{}
]
},
"speaker": "O_GUARD"
}
],
"text": {
"en": "Merci, je me sens bizarre..."
},
