"dialogs": [
{
"sid": 12,
"uid": "D_HERO",
"content": {
"sentence": {
"sentences": [
{
"id": 3,
"text": {
"en": "Je ne vois pas comment utiliser ces deux objets ensemble."
},
"voice": {
"en": [
{},
{},
{},
{}
]
},
"speaker": "O_NEW"
},
{
"id": 4,
"text": {
"en": "J'aurais besoin d'une clé pour l'ouvrir."
},
"voice": {
"en": [
{},
{},
{},
{}
]
},
"speaker": "O_NEW"
},
{
"id": 5,
"text": {
"en": "Il semblerait que ce lavabo soit cassé."
},
"voice": {
"en": [
{},
{},
{},
{}
]
},
"speaker": "O_NEW"
},
{
"id": 6,
"text": {
"en": "Le code est lier au journal de sortie de l'infirmerie."
},
"voice": {
"en": [
{},
{},
{},
{}
]
},
"speaker": "O_NEW"
},
{
"id": 7,
"text": {
"en": "Il me faut une emprinte digital."
},
"voice": {
"en": [
{},
{},
{},
{}
]
},
"speaker": "O_NEW"
},
{
"id": 8,
"text": {
"en": "Il me faudrait une carte électromagnétique."
},
"voice": {
"en": [
{},
{},
{},
{}
]
},
"speaker": "O_NEW"
}
],
"voice": {
"en": [
{},
{},
{},
{}
]
}
},
"nextID": 9
}
},
{
"sid": 86,
"uid": "D_CAFETERIA",
"content": {
"sentence": {
"voice": {
"en": [
{},
{},
{},
{}
]
},
"sentences": [
{
"id": 1,
"text": {
"en": "J'aurais besoin d'une clé pour l'ouvrir."
},
"voice": {
"en": [
{},
{},
{},
{}
]
},
"speaker": "O_NEW"
}
]
},
"nextID": 2
}
},
{
"sid": 87,
"uid": "D_GUARD",
"content": {
"sentence": {
"sentences": [
{
"id": 4,
"sentences": [
{
"id": 5,
"text": {
"en": "Aujourd'hui, tu es chargé de préparer les repas, au boulot."
},
"voice": {
"en": [
{},
{},
{},
{}
]
},
"speaker": "O_GUARD"
}
],
"text": {
"en": "Boujour."
},
"voice": {
"en": [
{},
{},
{},
{}
]
},
"speaker": "O_NEW"
},
{
"id": 6,
"sentences": [
{
"id": 7,
"sentences": [
{
"id": 8,
"text": {
"en": "Pousse-toi, je dois passer."
},
"voice": {
"en": [
{},
{},
{},
{}
]
},
"speaker": "O_GUARD"
}
],
"text": {
"en": "Merci, je me sens bizarre..."
},
"voice": {
"en": [
{},
{},
{},
{}
]
},
"speaker": "O_GUARD"
}
],
"text": {
"en": "Tenez votre taco."
},
"voice": {
"en": [
{},
{},
{},
{}
]
},
"speaker": "O_NEW"
}
],
"voice": {
"en": [
{},
{},
{},
{}
]
}
},
"nextID": 9
}
